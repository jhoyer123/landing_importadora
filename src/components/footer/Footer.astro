---
import facebook from "@/assets/facebook.svg";
import instagram from "@/assets/instagram.svg";
import tiktok from "@/assets/tiktok.svg";
import x from "@/assets/x.svg";

interface SocialMedia {
  name: string;
  link: string;
  icon: ImageMetadata;
  ariaLabel: string;
}

const socialMedias: SocialMedia[] = [
  {
    name: "Facebook",
    link: "https://facebook.com",
    icon: facebook,
    ariaLabel: "Siguenos en Facebook",
  },
  {
    name: "Instagram",
    link: "https://instagram.com",
    icon: instagram,
    ariaLabel: "Siguenos en Instagram",
  },
  {
    name: "TikTok",
    link: "https://tiktok.com",
    icon: tiktok,
    ariaLabel: "Siguenos en TikTok",
  },
  { name: "X", link: "https://x.com", icon: x, ariaLabel: "Siguenos en X" },
];
---

<footer
  class="text-black bg-white px-4 py-30 md:pt-20 md:pb-10 w-full mx-auto md:px-8 relative"
>
  <div class="max-w-6xl mx-auto grid gap-8 md:grid-cols-3 md:items-start">
    <div class="md:col-span-1 text-center md:text-left">
      <h2 class="text-3xl font-extrabold">LOGO</h2>
      <p class="mt-2 leading-relaxed text-[15px]">
        Importadores y distribuidores internacionales, soluciones logísticas y
        suministro de productos de calidad.
      </p>
    </div>

    <div class="md:col-span-1">
      <h3 class="font-semibold mb-2">Contacto</h3>
      <ul class="space-y-1 text-sm">
        <li>Dirección: Av. Principal 123, Zona Comercial, Ciudad, País</li>
        <li>
          Tel 1: <a href="tel:+59112345678" class="text-blue-600"
            >+591 123 45678</a
          >
        </li>
        <li>
          Tel 2: <a href="tel:+59198765432" class="text-blue-600"
            >+591 987 65432</a
          >
        </li>
        <li>
          Email: <a href="mailto:contacto@miempresa.com" class="text-blue-600"
            >contacto@miempresa.com</a
          >
        </li>
        <li>Horario: Lun-Vie 9:00 — 18:00</li>
      </ul>
    </div>

    <div class="md:col-span-1 text-center md:text-right">
      <h3 class="font-semibold mb-10 text-center md:text-start">Síguenos</h3>
      <div class="flex justify-center md:justify-start gap-8 md:mb-0">
        {
          socialMedias.map((media) => (
            <a
              href={media.link}
              aria-label={media.ariaLabel}
              target="_blank"
              rel="noopener noreferrer"
            >
              <img
                src={media.icon.src}
                alt={media.name}
                width="30"
                height="30"
                class="w-7 h-7 sm:w-8 sm:h-8"
              />
            </a>
          ))
        }
      </div>
    </div>
  </div>
  <div class="mt-6 text-center sm:text-left mb-10 sm:mt-8 mx-auto max-w-6xl">
    &copy; 2026 Importadora MiEmpresa. Todos los derechos reservados.
  </div>
</footer>

<style scoped>
  .svg-icon path,
  .svg-icon polygon,
  .svg-icon rect {
    fill: currentColor;
  }
</style>
