---
import VideoBackground from "@/components/hero/VideoBackground.astro";
import heroBackground from "@/images/heroBackground.jpg";
import { Image } from "astro:assets";
import Phone from "@/icons/Phone.astro";
---

<section class="h-screen w-full" id="hero">
  <!-- Hero Image for Mobile -->
  <Image
    src={heroBackground}
    alt="Hero Image"
    width="1200"
    height="1200"
    quality="high"
    class="absolute z-0 inset-0 object-cover h-screen w-full object-center md:hidden"
  />

  <!-- Hero Video Background for Desktop  -->
  <VideoBackground
    poster="/src/images/heroBackground.jpg"
    class="absolute inset-0 w-full h-full"
  >
    <div
      class="h-screen w-full max-w-6xl mx-auto flex flex-col justify-center items-center text-center gap-15 mt-12
      sm:items-center sm:justify-center sm:mt-0
      lg:items-start md:px-4"
    >
      <!-- titulo -->
      <div class="relative">
        <h1
          class="font-title font-extrabold text-3xl text-white text-start relative p-2 px-8 z-10
          sm:text-5xl sm:text-start
          lg:text-start lg:max-w-6xl
          xl:text-7xl"
        >
          Tu socio estratégico para importar desde cualquier lugar del mundo
          hasta Bolivia.
        </h1>
      </div>

      <!-- button -->
      <a
        href="https://web.whatsapp.com/"
        target="_blank"
        class="max-w-70 relative z-10 gap-3 flex items-center justify-between rounded-full bg-accent text-accent-foreground font-medium transition mt-10 ml-2 animate-bounce cursor-pointer
        md:mt-5"
      >
        <span class="pl-9 py-2 font-title font-bold text-md mx-auto"
          >Cotizar importación</span
        >
        <span
          class="flex items-center justify-center w-15 h-15 group-hover:translate-x-1 bg-black rounded-full text-accent border border-white"
        >
          <Phone />
        </span>
      </a>
      <!-- description -->
      <div class="relative flex justify-center items-end">
        <p
          class="inline-block font-body text-sm md:text-md text-white/90 text-center relative z-10 p-2 w-auto max-w-70 rounded-l-2xl
          sm:text-xl sm:rounded-2xl sm:max-w-100
          md:max-w-xl md:p-5 md:text-center
          lg:text-left"
        >
          No solo movemos carga, gestionamos tu inversión. Especialistas en
          desaduanamiento, logística internacional y normativa vigente para
          asegurar que tu mercadería llegue a destino sin multas ni demoras.
        </p>
      </div>
    </div>
  </VideoBackground>
</section>
