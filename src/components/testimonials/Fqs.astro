---
interface FAQ {
  question: string;
  answer: string;
}

const faqs: FAQ[] = [
  {
    question: "¿En cuánto tiempo llega mi importación?",
    answer:
      "El tiempo promedio de llegada desde Estados Unidos es de 30 a 45 días, y desde China o Asia entre 45 a 60 días. Estos plazos pueden variar ligeramente dependiendo de la disponibilidad de buques y los trámites aduaneros, pero te mantendremos informado durante todo el trayecto con actualizaciones semanales.",
  },
  {
    question: "¿Qué incluye el precio que me cotizan?",
    answer:
      "Nos gusta ser totalmente transparentes. En nuestra cotización detallamos el costo del producto en origen, el flete marítimo, los seguros y los impuestos aduaneros. No tendrás sorpresas ni cobros ocultos al final; el precio acordado en el contrato es el precio final.",
  },
  {
    question: "¿Cómo aseguro mi dinero durante el proceso?",
    answer:
      "Tu tranquilidad es nuestra prioridad. Todas nuestras operaciones se respaldan mediante un contrato legal notariado que especifica los datos del vehículo o mercancía, los tiempos de entrega y los montos. Además, emitimos factura por nuestros servicios y contamos con oficina física donde puedes visitarnos.",
  },
  {
    question: "¿Se encargan de todos los trámites de Aduana?",
    answer:
      "Absolutamente. Nuestro servicio es llave en mano. Nosotros gestionamos la documentación, los pagos de impuestos, la legalización y el desaduanaje. Tú solo tienes que esperar a recibir tu vehículo o carga lista para usar.",
  },
  {
    question: "¿Cómo es la forma de pago?",
    answer: `Generalmente trabajamos en dos etapas para tu comodidad. Primer pago: cubre la compra del producto en origen (subasta o proveedor) y el flete. Segundo pago: se realiza cuando la mercadería llega a puerto, para cubrir los gastos de nacionalización (Aduana) y la entrega final.`,
  },
];
---

<section class="faq-section">
  <!-- Imagen de fondo -->
  <img
    src="https://i.pinimg.com/1200x/7a/b8/a5/7ab8a5c10dadba66b556f342494da670.jpg"
    alt="Background"
    class="faq-bg"
    loading="lazy"
  />

  <!-- Overlay -->
  <div class="faq-overlay"></div>

  <div class="faq-container">
    <div class="faq-header">
      <span class="faq-label">Preguntas</span>
      <h2
        data-aos="zoom-in"
        class="text-gray-50 text-2xl md:text-4xl font-bold text-balance text-center"
      >
        Preguntas Frecuentes
      </h2>
    </div>

    <div class="faq-list">
      {
        faqs.map((faq) => (
          <div class="faq-item" data-aos="fade-up">
            <button class="faq-question" aria-expanded="false">
              <span>{faq.question}</span>
              <svg
                class="faq-icon"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
              >
                <path
                  class="icon-v"
                  d="M12 5V19"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                />
                <path
                  d="M5 12H19"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                />
              </svg>
            </button>
            <div class="faq-answer">
              <p>{faq.answer}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  document
    .querySelectorAll<HTMLButtonElement>(".faq-question")
    .forEach((btn) => {
      btn.addEventListener("click", () => {
        const item = btn.closest<HTMLDivElement>(".faq-item")!;
        const answer = item.querySelector<HTMLDivElement>(".faq-answer")!;
        const isOpen = btn.getAttribute("aria-expanded") === "true";

        // Cerrar todos
        document.querySelectorAll<HTMLDivElement>(".faq-item").forEach((el) => {
          el.querySelector("button")!.setAttribute("aria-expanded", "false");
          el.classList.remove("is-open");
          const a = el.querySelector<HTMLDivElement>(".faq-answer")!;
          a.style.maxHeight = "0";
        });

        // Abrir el clickeado si estaba cerrado
        if (!isOpen) {
          btn.setAttribute("aria-expanded", "true");
          item.classList.add("is-open");
          answer.style.maxHeight = answer.scrollHeight + "px";
        }
      });
    });
</script>

<style>
  .faq-section {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 1.5rem;
    overflow: hidden;
  }

  .faq-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Sin transform3d ni will-change para no sobrecargar móvil */
  }

  .faq-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.8);
  }

  .faq-container {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 860px;
    margin: 0 auto;
    height: auto;
  }

  .faq-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .faq-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 1rem;
  }

  .faq-title {
    font-size: clamp(1.75rem, 5vw, 3rem);
    font-weight: 700;
    color: #fff;
    margin: 0;
  }

  /* Lista */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* Item */
  .faq-item {
    background: #1849b2;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1rem;
    overflow: hidden;
    /* Sin backdrop-filter: mejora mucho el rendimiento en móvil */
  }

  .faq-item.is-open {
    border-color: rgba(255, 255, 255, 0.2);
  }

  /* Botón pregunta */
  .faq-question {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.5rem;
    background: none;
    border: none;
    color: #fff;
    font-size: 1rem;
    font-weight: 500;
    text-align: left;
    cursor: pointer;
    /* Sin :hover en móvil — usamos active en su lugar */
  }

  /* En desktop sí mostramos hover */
  @media (hover: hover) {
    .faq-question:hover {
      color: rgba(255, 255, 255, 0.8);
    }
  }

  /* En táctil usamos :active para feedback inmediato */
  .faq-question:active {
    opacity: 0.8;
  }

  /* Icono + */
  .faq-icon {
    flex-shrink: 0;
    color: rgba(255, 255, 255, 0.5);
    transition:
      transform 0.3s ease,
      color 0.3s ease;
  }

  .faq-item.is-open .faq-icon {
    transform: rotate(45deg);
    color: #a0afb0;
  }

  /* Respuesta — usando max-height para animación simple y eficiente */
  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s ease;
  }

  .faq-answer p {
    padding: 0 1.5rem 1.5rem;
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.75);
  }

  /* Responsive */
  @media (max-width: 640px) {
    .faq-section {
      padding: 3rem 1rem;
    }

    .faq-question {
      padding: 1.25rem;
      font-size: 0.95rem;
    }

    .faq-answer p {
      padding: 0 1.25rem 1.25rem;
    }
  }

  /* Accesibilidad */
  @media (prefers-reduced-motion: reduce) {
    .faq-answer,
    .faq-icon {
      transition: none;
    }
  }
</style>
