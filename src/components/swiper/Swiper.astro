---
import "swiper/css";
import "swiper/css/navigation";
import "swiper/css/pagination";

interface Props {
  id?: string;
  direction?: "horizontal" | "vertical";
  mobile?: number;
  tablet?: number;
  desktop?: number;
}

const {
  id = "swiper-reutilizable",
  direction = "horizontal",
  mobile = 1,
  tablet = 2,
  desktop = 3,
} = Astro.props;
---

<div class="swiper-container-wrapper relative">
  <div
    class="swiper"
    id={id}
    data-direction={direction}
    data-mobile={mobile}
    data-tablet={tablet}
    data-desktop={desktop}
  >
    <div class="swiper-wrapper">
      <slot />
    </div>
    <div class="swiper-pagination"></div>
  </div>
</div>

<style>
  .swiper {
    width: 100%;
    /* Quitamos el padding-bottom fijo si no quieres huecos */
    padding-bottom: 40px;
  }

  .swiper-wrapper {
    /* Esto permite que si las cards tienen distinto contenido, 
       todas se estiren para medir lo mismo que la más alta del grupo */
    align-items: stretch;
  }

  :global(.swiper-slide) {
    /* ESTA ES LA CLAVE: altura automática según el contenido */
    height: auto;
    display: flex;
  }
</style>

<script>
  import Swiper from "swiper";
  import { Navigation, Pagination, Autoplay } from "swiper/modules";

  function initSwipers() {
    const swipers = document.querySelectorAll(".swiper");

    swipers.forEach((el) => {
      const { direction, mobile, tablet, desktop } = (el as HTMLElement)
        .dataset;

      new Swiper(el as HTMLElement, {
        modules: [Navigation, Pagination, Autoplay],
        // @ts-ignore
        direction: direction || "horizontal",
        // autoHeight: true hace que el contenedor se ajuste a la card activa
        autoHeight: direction === "vertical" ? true : false,
        loop: true,
        spaceBetween: 20,
        slidesPerView: Number(mobile),

        // ← AUTOPLAY DIRECTO
        autoplay: {
          delay: 4000,
          disableOnInteraction: false,
          pauseOnMouseEnter: true,
        },

        breakpoints: {
          640: { slidesPerView: Number(tablet) },
          1024: { slidesPerView: Number(desktop) },
        },
        pagination: {
          el: el.querySelector(".swiper-pagination") as HTMLElement,
          clickable: true,
        },
      });
    });
  }

  document.addEventListener("astro:page-load", initSwipers);
  initSwipers();
</script>
