---
import about from "@/images/about.webp";
import aboutGroup from "@/images/aboutGroup.webp";
import carla from "@/images/carla.webp";
import { Image } from "astro:assets";

import Benefits1 from "@/icons/Benefits1.astro";
import Benefits2 from "@/icons/Benefits2.astro";
import Benefits3 from "@/icons/Benefits3.astro";

interface Benefits {
  title: string;
  description: string;
  icon: typeof Benefits1;
}

const benefits: Benefits[] = [
  {
    title: "Costo Optimizado",
    description:
      "Procesos eficientes y asesoría especializada para reducir costos en cada importación.",
    icon: Benefits1,
  },
  {
    title: "Tránsito Reducido",
    description:
      "Gestión ágil en aduanas y coordinación logística para minimizar tiempos de despacho.",
    icon: Benefits2,
  },
  {
    title: "Entrega a Tiempo",
    description:
      "Tu mercadería llega a destino cumpliendo plazos, normas y documentación exigida.",
    icon: Benefits3,
  },
];
---

<section class="bg-linear-to-b from-[#091117] to-transparent py-30" id="about">
  <div class="max-w-6xl mx-auto px-4">
    <!-- Header con beneficios -->
    <div class="flex flex-col gap-10 items-center text-center">
      <!-- indicator -->
      <span class="text-gray-300 tracking-widest">Sobre Nosotros</span>
      <!-- Título -->
      <h2
        class="text-gray-100 font-title text-xl font-bold text-center md:text-2xl lg:text-4xl"
      >
        Expertos en importación y gestión aduanera
      </h2>

      <!-- Sección principal About -->
      <div
        class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center lg:mt-5"
      >
        <!-- Imágenes lado izquierdo -->
        <div class="relative">
          <div class="relative z-0">
            <Image
              src={about}
              alt="Logística y transporte"
              class="rounded-lg w-full object-cover"
            />
          </div>
          <div
            class="absolute -bottom-20 right-20 z-5 w-48 h-40 -mr-8 -mb-8
          md:w-100 md:h-48 md:-mr-12 md:-mb-12
          lg:w-48 lg:h-40 lg:-mr-8 lg:-mb-8"
          >
            <Image
              src={aboutGroup}
              alt="Contenedores"
              class="rounded-lg w-full h-full object-cover border-4 border-white shadow-lg"
            />
          </div>
        </div>

        <!-- Contenido lado derecho -->
        <div class="mt-25 flex flex-col gap-3
        lg:mt-0">
          <!-- Marca -->
          <div class="mb-4 bg-gray-900 py-1">
            <span class="text-sm font-bold text-gray-100"
              >DESDE HACE 15+ AÑOS</span
            >
          </div>

          <!-- Descripción -->
          <p
            class="text-gray-100 text-sm font-body mb-6
          lg:text-base lg:text-start"
          >
            Acompañamos a empresas y emprendedores en todo el proceso de
            importación, desde el origen hasta la entrega final en Bolivia. Nos
            especializamos en desaduanamiento, logística internacional y
            cumplimiento normativo, asegurando operaciones seguras, rápidas y
            sin contratiempos. Nuestro equipo trabaja de forma personalizada
            para que cada carga cumpla con la normativa vigente y llegue a
            destino sin multas ni demoras innecesarias.
          </p>

          <!-- Testimonial -->
          <div class="border-gray-200 bg-gray-200 py-8 px-2 rounded-lg">
            <div class="flex justify-center items-center gap-4 mb-4">
              <Image
                width={100}
                height={100}
                src={carla}
                alt="Testimonio"
                class="w-12 h-12 rounded-full object-cover"
              />
              <div>
                <h4 class="font-bold text-gray-900">Carla Mendoza</h4>
                <p class="text-sm text-gray-600">
                  CEO & Fundador de Importadora Plus
                </p>
              </div>
            </div>
            <p class="text-gray-700 italic">
              "El mejor servicio de importación que hemos usado. Profesionales y
              confiables."
            </p>
          </div>
        </div>
      </div>

      <!-- Cards de beneficios -->
      <div
        class="grid grid-cols-1 sm:grid-cols-3 gap-8 md:gap-12
      lg:mt-20"
      >
        {
          benefits.map((benefit) => (
            <div class="text-center">
              <div class="bg-[#1849B2] w-20 h-20 mx-auto rounded-full flex items-center justify-center mb-4 text-gray-100">
                <benefit.icon />
              </div>
              <h3 class="font-bold text-gray-900 mb-2">{benefit.title}</h3>
              <p class="text-gray-900 text-sm lg:text-base">
                {benefit.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
