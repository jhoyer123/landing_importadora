---
import VideoBackground from "@/components/hero/VideoBackground.astro";
import heroBackground from "@/images/heroBackground.jpg";
import { Image } from "astro:assets";
import Phone from "@/icons/Phone.astro";
---

<section class="h-screen w-full relative" id="hero">
  <!-- Hero Image for Mobile -->
  <Image
    src={heroBackground}
    alt="Hero Image"
    width="1200"
    height="1200"
    quality="high"
    class="absolute inset-0 object-cover h-full w-full object-center md:hidden"
  />
  <!-- Hero Video Background for Desktop  -->
  <VideoBackground
    poster="/src/images/heroBackground.jpg"
    class="absolute inset-0"
  >
    <div class="px-4 h-full w-full">
      <div
        class="h-full w-full max-w-6xl mx-auto flex flex-col justify-center items-center gap-15 mt-12
      sm:mt-0
      lg:items-start"
      >
        <!-- titulo -->
        <div class="relative">
          <h1
            class="animate-up font-title font-extrabold text-3xl text-white text-center tracking-wider
          sm:text-5xl
          lg:text-start lg:max-w-6xl
          xl:text-7xl"
          >
            Tu socio estratégico para importar desde cualquier lugar del mundo
            hasta Bolivia.
          </h1>
        </div>

        <!-- button -->
        <a
          href="https://web.whatsapp.com/"
          target="_blank"
          class="animate-left bg-[#1849B2] max-w-70 relative z-10 gap-3 flex items-center justify-between rounded-full text-accent-foreground font-medium transition mt-10 ml-2 animate-bounce cursor-pointer border border-white
        md:mt-5 md:ml-0"
        >
          <span
            class="pl-9 py-2 font-title font-bold text-md mx-auto text-white"
            >Cotizar importación</span
          >
          <span
            class="flex items-center justify-center w-15 h-15 group-hover:translate-x-1 bg-black rounded-full text-accent border-2 border-white"
          >
            <Phone />
          </span>
        </a>
        <!-- description -->
        <div class="relative flex justify-center items-end">
          <p
            class=" animate-down inline-block font-body text-sm text-white/90 text-center w-auto max-w-70
          sm:text-xl sm:max-w-100
          md:max-w-xl md:text-md
          lg:text-left"
          >
            No solo movemos carga, gestionamos tu inversión. Especialistas en
            desaduanamiento, logística internacional y normativa vigente para
            asegurar que tu mercadería llegue a destino sin multas ni demoras.
          </p>
        </div>
      </div>
    </div>
  </VideoBackground>
</section>
