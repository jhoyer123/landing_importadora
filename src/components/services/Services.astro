---
/**
 * StatsSection Component
 * 
 * A responsive statistics showcase component featuring a hero image
 * alongside key business metrics. Implements a two-column layout that
 * adapts to single column on mobile devices.
 */

 import Certificate from "@/icons/Certificate.astro";
 import Container from "@/icons/Container.astro";
 import FileCheck from "@/icons/FileCheck.astro";
 import Clock from "@/icons/Clock.astro";

interface ServiceItem {
  label: string;
  description: string;
  icon: any;
  img: string;
}

const serviceFirst: ServiceItem[] = [
  {
    label: "Gestión Aduanera Especializada",
    description: "clasificación arancelaria precisa para optimizar el pago de tributos (GA, IVA) y evitar contravenciones. Gestión total de documentos (Bill of Lading, CRT, MIC/DTA).",
    icon: Container,
    img: "https://i.pinimg.com/1200x/86/29/2a/86292a40368664b0655fc88e6e2014cc.jpg"
  },
  {
    label: "Transporte Multimodal (FCL / LCL)",
    description: "Soluciones de contenedor completo o carga consolidada desde los principales puertos del mundo hasta Arica o Iquique, con tramo final terrestre hasta Bolivia.",
    icon: FileCheck,
    img: "https://i.pinimg.com/736x/a5/15/c5/a515c50d2bbfed11f2dc4b1631e9f9e0.jpg"
  },
  {
    label: "Verificación de Proveedores (Sourcing)",
    description: "Inspecciones de pre-embarque en origen y validación legal de fábricas en China para evitar estafas y asegurar la calidad de tu pedido.",
    icon: Clock,
    img: "https://i.pinimg.com/736x/1e/a3/4e/1ea34e8acc4952992545a1ac75d4466f.jpg"
  },
  {
    label: "Permisos y Certificaciones",
    description: "Gestión ante SENASAG, IBMETRO o Sustancias Controladas, garantizando el cumplimiento de la normativa técnica antes de que la carga llegue a frontera.",
    icon: Certificate,
    img: "https://i.pinimg.com/1200x/da/56/f9/da56f9ef118d68b319561182a8319327.jpg"
  },
];
---

<section class="w-full py-30 relative px-4 glass-wet-gradient" id="services">
  <div class="max-w-6xl mx-auto relative z-5 flex flex-col gap-10">
    <!-- title section -->
     <h2 class="text-gray-100 font-title text-xl font-bold text-center md:text-2xl lg:text-4xl">Servicios Especializados</h2>

    <!-- description -->
     <p class="text-gray-200 text-center font-body text-base md:px-20">No solo movemos carga, gestionamos tu inversión. Especialistas en desaduanamiento, logística internacional y normativa vigente para asegurar que tu mercadería llegue a destino sin multas ni demoras.</p>

      <!-- Statistics grid -->
      <div class="space-y-8 grid 
      md:grid-cols-2 md:gap-6 md:space-y-0
      lg:grid-cols-4">
        {serviceFirst.map((stat, index) => (
          <div 
            class="pt-5 flex flex-col gap-6 shadow-xl border-b-4 border-b-black bg-white rounded-xl hover:shadow-md border border-stone-200 items-center justify-between hover:border-accent hover:scale-105 transition duration-300
            md:gap-10"
          >
             <!-- Stat icon -->
            <div class="shrink-0 w-auto">
              <stat.icon className="w-15 h-15" />
            </div>
            <!-- Stat content -->
            <div class="flex-1 font-body flex flex-col justify-between space-y-2 px-5">
              <h4 class="text-base font-bold text-stone-900 uppercase tracking-wide">
                {stat.label}
              </h4>
              <p class="text-sm text-stone-600 leading-relaxed
              md:text-base">
                {stat.description}
              </p>
            </div>

              <!-- Stat image -->
            <div class="relative w-full h-80 rounded-lg overflow-hidden">
              <img
                src={stat.img}
                alt={stat.label}
                class="absolute w-full h-full object-cover object-center"
              />
            </div>
          </div>
        ))}
    </div>
  </div>
</section>

<style>
  /**
   * Custom animations and refinements
   * Enhances the user experience with subtle interactions
   */
  
  /* Smooth image loading */
  img {
    animation: fadeIn 0.6s ease-in;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* Staggered stat card animation */
  .space-y-8 > div {
    animation: slideInRight 0.5s ease-out backwards;
  }

  .space-y-8 > div:nth-child(1) { animation-delay: 0.1s; }
  .space-y-8 > div:nth-child(2) { animation-delay: 0.2s; }
  .space-y-8 > div:nth-child(3) { animation-delay: 0.3s; }
  .space-y-8 > div:nth-child(4) { animation-delay: 0.4s; }

  @keyframes slideInRight {
    from {
      opacity: 0;
      transform: translateX(30px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
</style>