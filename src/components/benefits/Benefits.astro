---
import CardsBenefits from "@/components/benefits/CardsBenefits.astro";
---

<!-- SECCIÓN 5: PILARES DE CONFIANZA - Mejorada -->
<section class="relative bg-linar-to-b from-slate-50 to-white py-10 md:py-24" id="results">
  <div
    class="max-w-6xl mx-auto px-4 lg:px-0 flex flex-col gap-5 items-center"
  >
    <!-- Header -->
    <span
      class="bg-indigo-100 text-indigo-700 text-sm font-semibold px-4 py-2 rounded-full mb-4"
    >
      Servicios Especializados
    </span>
    <!-- Title -->
    <h2
      class="font-title text-xl font-bold text-center md:text-2xl lg:text-4xl"
    >
      No solo movemos carga sino gestionamos tu inversión
    </h2>
    <!-- description -->
    <p class="text-center font-body text-base md:px-20">
      Especialistas en desaduanamiento, logística internacional y normativa
      vigente. Importamos desde USA, China, Brasil y Chile con respaldo legal
      completo y trazabilidad garantizada.
    </p>

    <!-- Stats -->
    <div class="bg-background w-full">
      <div class="px-4 xl:px-0 py-10 mx-auto">
        <div class="border border-line-2 rounded-xl">
          <div
            class="p-4 lg:p-8 bg-linear-to-bl from-layer via-background to-background-1 rounded-xl"
          >
            <div
              class="grid grid-cols-1 sm:grid-cols-3 items-center gap-y-20 gap-x-12"
            >
              <!-- Stat 1: Años de experiencia -->
              <div
                class="relative text-center first:before:hidden before:absolute before:-top-full sm:before:top-1/2 before:start-1/2 sm:before:-start-6 before:h-20 before:border-s before:border-line-2 before:rotate-60 sm:before:rotate-12 before:transform sm:before:-translate-y-1/2 before:-translate-x-1/2 sm:before:translate-x-0 before:mt-3.5 sm:before:mt-0"
              >
                <svg
                  class="shrink-0 size-6 sm:size-8 text-primary mx-auto"
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M3 3v18h18"></path>
                  <path d="m19 9-5 5-4-4-3 3"></path>
                </svg>
                <div class="mt-3 sm:mt-5">
                  <h3 class="text-lg sm:text-3xl font-semibold text-foreground">
                    15+ Años
                  </h3>
                  <p class="mt-1 text-sm sm:text-base text-muted-foreground-1">
                    De experiencia en comercio internacional
                  </p>
                </div>
              </div>
              <!-- End Stat 1 -->

              <!-- Stat 2: Operaciones completadas -->
              <div
                class="relative text-center first:before:hidden before:absolute before:-top-full sm:before:top-1/2 before:start-1/2 sm:before:-start-6 before:h-20 before:border-s before:border-line-2 before:rotate-60 sm:before:rotate-12 before:transform sm:before:-translate-y-1/2 before:-translate-x-1/2 sm:before:translate-x-0 before:mt-3.5 sm:before:mt-0"
              >
                <svg
                  class="shrink-0 size-6 sm:size-8 text-primary mx-auto"
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
                <div class="mt-3 sm:mt-5">
                  <h3 class="text-lg sm:text-3xl font-semibold text-foreground">
                    5,000+
                  </h3>
                  <p class="mt-1 text-sm sm:text-base text-muted-foreground-1">
                    Importaciones exitosas completadas
                  </p>
                </div>
              </div>
              <!-- End Stat 2 -->

              <!-- Stat 3: Clientes activos -->
              <div
                class="relative text-center first:before:hidden before:absolute before:-top-full sm:before:top-1/2 before:start-1/2 sm:before:-start-6 before:h-20 before:border-s before:border-line-2 before:rotate-60 sm:before:rotate-12 before:transform sm:before:-translate-y-1/2 before:-translate-x-1/2 sm:before:translate-x-0 before:mt-3.5 sm:before:mt-0"
              >
                <div class="flex justify-center items-center -space-x-5">
                  <img
                    class="relative z-2 shrink-0 size-8 rounded-full border-3 border-line-2"
                    src="https://images.unsplash.com/photo-1601935111741-ae98b2b230b0?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=facearea&facepad=2&w=320&h=320&q=80"
                    alt="Cliente satisfecho"
                  />
                  <img
                    class="relative z-1 shrink-0 size-8 rounded-full border-3 border-line-2 -mt-7"
                    src="https://images.unsplash.com/photo-1570654639102-bdd95efeca7a?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=facearea&facepad=2&w=320&h=320&q=80"
                    alt="Cliente satisfecho"
                  />
                  <img
                    class="relative shrink-0 size-8 rounded-full border-3 border-line-2"
                    src="https://images.unsplash.com/photo-1679412330254-90cb240038c5?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=facearea&facepad=2.5&w=320&h=320&q=80"
                    alt="Cliente satisfecho"
                  />
                </div>
                <div class="mt-3 sm:mt-5">
                  <h3 class="text-lg sm:text-3xl font-semibold text-foreground">
                    200+
                  </h3>
                  <p class="mt-1 text-sm sm:text-base text-muted-foreground-1">
                    Clientes activos importando con nosotros
                  </p>
                </div>
              </div>
              <!-- End Stat 3 -->
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- End Stats -->

    <!-- Pilares Grid -->
    <CardsBenefits />
  </div>
</section>
