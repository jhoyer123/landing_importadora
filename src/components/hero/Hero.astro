---
import VideoBackground from "@/components/hero/VideoBackground.astro";
import heroBackground from "@/images/heroBackground.jpg";
import { Image } from "astro:assets";
import Phone from "@/icons/Phone.astro";
---

<section class="h-screen w-full" id="hero">
  <!-- Hero Image for Mobile -->
  <Image
    src={heroBackground}
    alt="Hero Image"
    width="1920"
    height="1080"
    class="absolute z-0 inset-0 object-cover object-center h-full w-full md:hidden"
  />

  <!-- Hero Video Background for Desktop  -->
  <VideoBackground
    src="/src/videos/videoBackground.mp4"
    poster="/src/images/heroBackground.jpg"
    class="absolute inset-0 w-full h-full"
  >
    <!-- overlide -->
    <div
      class="absolute inset-0 bg-linear-to-t from-black/20 via-black/10 to-transparent"
    >
    </div>
    <div
      class="h-screen w-full max-w-6xl mx-auto flex flex-col justify-center text-center gap-15 mt-12 px-4
      sm:items-center sm:justify-center sm:mt-0
      lg:items-start"
    >
      <!-- titulo -->
      <div class="relative">
        <h1
          class="font-title font-extrabold text-4xl text-white text-start relative p-2 z-10
          sm:text-5xl sm:text-center
          lg:text-start lg:max-w-6xl
          xl:text-7xl"
        >
          Tu socio estratégico para importar desde cualquier lugar del mundo
          hasta Bolivia.
        </h1>
        <div
          class="absolute z-5 inset-0 h-auto bg-linear-to-r from-black/30 via-black/20 to-transparent blur-xl
          sm:bg-linear-to-t sm:from-black/20 sm:via-black/10 sm:to-transparent
          lg:bg-linear-50"
        >
        </div>
      </div>
      <!-- description -->
      <div class="relative flex justify-end items-end">
        <p
          class="inline-block font-body text-md text-white/90 text-center relative z-10 bg-black/70 p-2 w-auto max-w-70 rounded-l-2xl
          sm:text-xl sm:rounded-2xl sm:text-center sm:max-w-100
          md:max-w-xl md:p-5"
        >
          No solo movemos carga, gestionamos tu inversión. Especialistas en
          desaduanamiento, logística internacional y normativa vigente para
          asegurar que tu mercadería llegue a destino sin multas ni demoras.
        </p>
      </div>
      <!-- button -->
      <a
        href="https://web.whatsapp.com/"
        target="_blank"
        class="max-w-70 relative z-10 gap-3 flex items-center justify-between rounded-full bg-accent text-accent-foreground font-medium transition ml-2 animate-bounce cursor-pointer
        md:mt-5"
      >
        <span class="pl-9 py-2 font-title font-bold text-md mx-auto"
          >Cotizar importación</span
        >
        <span
          class="flex items-center justify-center w-15 h-15 group-hover:translate-x-1 bg-black rounded-full text-accent border border-white"
        >
          <Phone />
        </span>
      </a>
    </div>
  </VideoBackground>
</section>
