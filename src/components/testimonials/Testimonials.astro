---
import { Image } from "astro:assets";
import Swiper from "../swiper/Swiper.astro";

// Importa tus imágenes
import cat1 from "@/images/cat1.jpg";
import cat2 from "@/images/cat2.jpg";
import cat3 from "@/images/cat3.jpg";

import bgt1 from "@/images/bgt1.webp";
import bgt2 from "@/images/bgt2.webp";

const testimonials = [
  {
    name: "Importación de Maquinaria Industrial",
    company: "Sector Agro e Industrial",
    role: "Tractor y maquinaria pesada",
    testimonial:
      "Gestionaron la importación completa de maquinaria agrícola desde origen hasta su nacionalización en Bolivia, cumpliendo plazos y normativa sin contratiempos.",
    image: cat1,
    rating: 5,
  },
  {
    name: "Importación de Vehículos",
    company: "Sector Automotriz",
    role: "Automóvil importado",
    testimonial:
      "La importación del vehículo fue rápida y transparente. Se encargaron de aduanas, documentación y entrega final sin complicaciones.",
    image: cat2,
    rating: 5,
  },
  {
    name: "Importación de Tecnología",
    company: "Sector Tecnológico",
    role: "Equipos electrónicos y tecnología",
    testimonial:
      "Importamos equipos tecnológicos y electrónicos con total seguridad. Excelente manejo de impuestos, permisos y tiempos de despacho.",
    image: cat3,
    rating: 5,
  },
];
---

<section class="py-30 px-4 relative h-auto w-full overflow-hidden" id="results">
  <!-- background -->
  <div class="absolute inset-0 grid lg:grid-cols-2">
    <div class="absolute inset-0 bg-black/40 ring-1 ring-black/5"></div>
    <Image
      width={1000}
      height={1000}
      src={bgt1}
      alt="Testimonial 1"
      class="w-full h-full object-cover hidden lg:block"
    />
    <Image
      src={bgt2}
      width={1000}
      height={1000}
      alt="Testimonial 2"
      class="w-full h-full object-cover"
    />
  </div>

  <div
    class="max-w-6xl mx-auto flex flex-col gap-10 lg:p-0 rounded-xl relative z-10 h-auto"
  >
    <!-- indicator -->
    <span class="text-gray-300 tracking-widest text-center">Resultados</span>
    <!-- title -->
    <h2
      class="text-gray-50 text-2xl md:text-4xl font-bold text-balance text-center"
    >
      Casos de Éxito
    </h2>
    <!-- description -->
    <p class="text-gray-200 text-sm md:text-base text-center">
      Testimonios de clientes satisfechos con nuestros servicios de importación
      y gestión aduanera.
    </p>

    <div class="flex flex-col lg:flex-row gap-6 items-stretch h-auto pb-30">
      <div class="w-full lg:w-7/12 h-64 lg:h-112">
        <div
          class="relative h-full w-full rounded-2xl overflow-hidden shadow-xl border border-white/10"
        >
          {
            testimonials.map((item, index) => (
              <div
                class={`testimonial-image absolute inset-0 transition-opacity duration-500 ${index === 0 ? "opacity-100" : "opacity-0"}`}
                data-index={index}
              >
                <Image
                  width={700}
                  height={700}
                  src={item.image}
                  alt={item.name}
                  class="w-full h-full object-cover"
                />
              </div>
            ))
          }
        </div>
      </div>

      <div class="w-full lg:w-5/12 h-112">
        <Swiper
          id="swiper-testimonios"
          direction="horizontal"
          mobile={1}
          tablet={1}
          desktop={1}
        >
          {
            testimonials.map((item, index) => (
              <div class="swiper-slide h-full!" data-slide-index={index}>
                <div class="bg-white rounded-2xl p-8 md:p-12 border border-gray-100 shadow-xl flex flex-col h-full w-full">
                  <div class="flex-1 flex flex-col justify-center">
                    <span class="text-6xl text-orange-500 font-serif leading-none mb-4">
                      “
                    </span>
                    <p class="text-gray-700 text-lg md:text-xl italic leading-relaxed">
                      {item.testimonial}
                    </p>
                  </div>

                  <div class="mt-8 pt-6 border-t border-gray-100">
                    <div class="flex gap-1 mb-4">
                      {Array.from({ length: item.rating }).map(() => (
                        <svg
                          class="w-5 h-5 text-yellow-400"
                          fill="currentColor"
                          viewBox="0 0 20 20"
                        >
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                      ))}
                    </div>
                    <h4 class="font-bold text-gray-900 text-lg">{item.name}</h4>
                    <p class="text-sm text-gray-500">
                      {item.role} -{" "}
                      <span class="text-orange-600 uppercase font-bold text-xs">
                        {item.company}
                      </span>
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </Swiper>
      </div>
    </div>
  </div>
</section>

<style>
  /* Importante: Swiper necesita que el contenedor tenga altura para el modo vertical */
  :global(.swiper) {
    height: 100% !important;
    width: 100% !important;
  }

  :global(.swiper-slide) {
    height: 100% !important;
  }
</style>

<script>
  function syncTestimonials() {
    const swiperEl = document.querySelector("#swiper-testimonios") as any;
    const images = document.querySelectorAll(".testimonial-image");

    if (swiperEl && swiperEl.swiper) {
      const swiperInstance = swiperEl.swiper;

      const updateImages = (index: number) => {
        images.forEach((img, idx) => {
          img.classList.toggle("opacity-100", idx === index);
          img.classList.toggle("opacity-0", idx !== index);
        });
      };

      swiperInstance.on("slideChange", () => {
        updateImages(swiperInstance.realIndex);
      });

      updateImages(swiperInstance.realIndex);
    }
  }

  document.addEventListener("astro:page-load", syncTestimonials);
  setTimeout(syncTestimonials, 400);
</script>
