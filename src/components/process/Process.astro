---
import { Image } from "astro:assets";

import processImage from "@/images/processImage.png";

interface Step {
  title: string;
  description: string;
}

const steps: Step[] = [
  {
    title: "Fase de Auditoría",
    description:
      "Análisis de factura comercial, lista de empaque y determinación de acuerdos comerciales (ACE-22 / CAN) para la liberación de aranceles.",
  },
  {
    title: "Consolidación y Embarque",
    description:
      "Coordinación de logística en origen (FOB/EXW) y estiba de mercancía bajo estándares internacionales de seguridad.",
  },
  {
    title: "Tránsito y Frontera",
    description: "Supervisión del tránsito marítimo y monitoreo GPS en el tramo terrestre hacia las aduanas de destino en Bolivia.",
  },
  {
    title: "Liquidación y Desaduanamiento",
    description:
      "RElaboración de la DMI (Declaración de Mercancías), pago de tributos y entrega final tras la obtención del Canal Verde.",
  },
];
---

<!-- Approach -->
<section class="bg-gray-900 text-gray-100" id="process">
  <!-- Approach -->
  <div class="max-w-6xl px-4 pb-30 xl:px-0 pt-10 lg:pt-20 lg:pb-40 mx-auto flex flex-col gap-10">
     <!-- indicator -->
     <span class="tracking-widest text-center">Proceso</span>
    <!-- Title -->
    <h2
      class="font-title text-xl font-bold text-center md:text-2xl lg:text-4xl"
    >
      ¿Cómo trabajamos?
    </h2>
    <!-- description -->
    <p class="text-center font-body text-base md:px-20">
      Nuestro proceso de importación se basa en una metodología probada que
      garantiza la eficiencia, seguridad y cumplimiento normativo en cada
      etapa del camino. Desde la auditoría inicial hasta la entrega final, nos
      encargamos de cada detalle para que tu experiencia de importación sea
      fluida y sin complicaciones.
    </p>
  
    <!-- Grid -->
    <div
      class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 lg:items-center"
    >
      <!-- Timeline -->
      <div class="sm:px-20 lg:px-0">
        <!-- Heading -->
        <div class="mb-4">
          <h3 class="text-primary text-xs font-medium uppercase">Pasos</h3>
        </div>
        <!-- End Heading -->

        { steps.map((step, index) => (
            <!-- Item -->
        <div class="flex gap-x-5 ms-1">
          <!-- Icon -->
          <div
            class="relative last:after:hidden after:absolute after:top-8 after:bottom-0 after:start-4 after:-translate-x-[0.5px] after:border-s after:border-line-2"
          >
            <div class="relative z-10 size-8 flex justify-center items-center">
              <span
                class="flex shrink-0 justify-center items-center size-8 border border-line-2 text-primary font-semibold text-xs uppercase rounded-full"
              >
                {index + 1}
              </span>
            </div>
          </div>

          <!-- Right Content -->
          <div class="grow pt-0.5 pb-8 sm:pb-12">
            <p class="text-sm md:text-base text-muted-foreground-1">
              <span class="text-base font-semibold">{step.title}:</span>
              {step.description}
            </p>
          </div>
        </div>
        ))}


        <a
          class="group inline-flex items-center gap-x-4 py-3 px-5 bg-primary border border-primary-line text-primary-foreground font-medium text-sm rounded-full focus:outline-hidden bg-[#1849B2] text-white hover:bg-white hover:text-black transition duration-300"
          href="https://api.whatsapp.com/send/?phone=5215512345678&text=Hola%2C+necesito+ayuda+con+una+importaci%C3%B3n&type=phone_number&app_absent=0"
        >
          <svg
            class="shrink-0 size-4"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
              d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
            ></path><path
              class="opacity-0 group-hover:opacity-100 group-focus:opacity-100 group-hover:delay-100 transition"
              d="M14.05 2a9 9 0 0 1 8 7.94"></path><path
              class="opacity-0 group-hover:opacity-100 group-focus:opacity-100 transition"
              d="M14.05 6A5 5 0 0 1 18 10"></path></svg
          >
          <span class="font-body text-base">Contáctanos</span>
        </a>
        
      </div>
    
       <!-- image process -->
      <Image
        width={1000}
        height={1000}
        src={processImage}
        alt="Proceso de importación"
        class="w-full rounded-lg object-cover"
      />
    </div>
  </div>
</section>
