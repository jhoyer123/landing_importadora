---
import Facebook from "@/icons/Facebook.astro";
import Twitter from "@/icons/Twitter.astro";
import Instagram from "@/icons/Instagram.astro";
import TikTok from "@/icons/Tiktok.astro";

import Close from "@/icons/Close.astro";

interface SocialMedia {
  name: string;
  link: string;
  icon: typeof Facebook;
  ariaLabel: string;
}

const socialMedias: SocialMedia[] = [
  {
    name: "Facebook",
    link: "https://facebook.com",
    icon: Facebook,
    ariaLabel: "Síguenos en Facebook",
  },
  {
    name: "Instagram",
    link: "https://instagram.com",
    icon: Instagram,
    ariaLabel: "Síguenos en Instagram",
  },
  {
    name: "TikTok",
    link: "https://tiktok.com",
    icon: TikTok,
    ariaLabel: "Síguenos en TikTok",
  },
  {
    name: "Twitter",
    link: "https://twitter.com",
    icon: Twitter,
    ariaLabel: "Síguenos en Twitter",
  },
];

interface MenuItem {
  name: string;
  link: string;
}

const itemsMenu: MenuItem[] = [
  { name: "Home", link: "/" },
  { name: "Sobre Nosotros", link: "#about" },
  { name: "Servicios", link: "#services" },
  { name: "Proceso", link: "#process" },
  { name: "Resultados", link: "#results" },
];
---

<div
  id="mobile-menu"
  class="h-screen w-[85vw] fixed z-50 -translate-x-full transition-transform duration-300 ease-in-out
  lg:h-auto lg:top-2 lg:left-1/2 lg:-translate-x-1/2 lg:w-max"
>
  <nav
    class="glass-wet-deep w-full h-full py-20 px-3 flex flex-col gap-10 justify-between
    sm:px-10
    md:px-15
    lg:px-10 lg:h-auto lg:flex-row lg:w-full lg:gap-80 lg:justify-between lg:items-center lg:py-2 lg:rounded-2xl"
  >
    <!-- button close -->
    <button
      id="close-menu-btn"
      class="absolute top-5 right-5 p-2 rounded-full hover:bg-gray-100 transition-colors lg:text-gray-100
      lg:hidden"
    >
      <Close />
    </button>
    <!-- logo -->
    <h2 class="text-2xl font-title font-bold lg:text-gray-100">LOGO</h2>
    <!-- items menu -->
    <ul class="flex flex-col gap-10 lg:text-gray-100
    lg:flex-row lg:mt-0">
      {
        itemsMenu.map((item) => (
          <li>
            <a
              href={item.link}
              class="font-body text-xl font-bold btn-menu lg:text-base lg:font-medium"
            >
              {item.name}
            </a>
          </li>
        ))
      }
    </ul>
    <!-- social media -->
    <div
      class="flex justify-between w-full gap-5
    sm:gap-7 sm:left-10
    md:gap-9 md:left-15
    lg:hidden"
    >
      {
        socialMedias.map((media) => (
          <a
            href={media.link}
            aria-label={media.ariaLabel}
            target="_blank"
            rel="noopener noreferrer"
          >
            <media.icon />
          </a>
        ))
      }
    </div>
  </nav>
</div>
