---
// components/VideoBackground.astro
export interface Props {
  src: string;
  poster?: string; // Imagen mientras carga
  class?: string;
}

const { src, poster, class: className = "" } = Astro.props;
---

<div class:list={["video-background", className]}>
  <!-- Video -->
  <video autoplay muted loop playsinline poster={poster} class="video-element">
    <source src={src} type="video/mp4" />
    <source src={src.replace(".mp4", ".webm")} type="video/webm" />
    Tu navegador no soporta video HTML5.
  </video>

  <!-- Contenido encima del video -->
  <div class="video-content">
    <slot />
  </div>
</div>

<style>
  .video-background {
    position: relative;
    width: 100%;
    min-height: 100vh;
    overflow: hidden;
  }

  .video-element {
    position: absolute;
    top: 50%;
    left: 50%;
    min-width: 100%;
    min-height: 100%;
    width: auto;
    height: auto;
    transform: translate(-50%, -50%);
    object-fit: cover;
    z-index: 0;
  }

  .video-content {
    position: relative;
    z-index: 10;
    min-height: 100vh;
  }

  /* Performance: Desactivar video en mobile */
  @media (max-width: 767px) {
    .video-element {
      display: none;
    }
  }
</style>
