---
import videoBackground from "@/videos/videoBackground.mp4";

export interface Props {
  poster?: string; // Imagen mientras carga
  class?: string;
}

const { poster, class: className } = Astro.props;
---

<div class:list={["video-background", className]}>
  <!-- Video -->
  <video autoplay muted loop playsinline poster={poster} class="video-element">
    <source src={videoBackground} type="video/mp4" />
    <source src={videoBackground.replace(".mp4", ".webm")} type="video/webm" />
    Tu navegador no soporta video HTML5.
  </video>

  <!-- Contenido encima del video -->
  <div class="video-content">
    <slot />
  </div>
</div>

<style>
  .video-background {
    position: relative;
    width: 100%;
    min-height: 100vh;
    overflow: hidden;
  }

  .video-element {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .video-content {
    position: relative;
    z-index: 10;
    height: 100vh;
  }

  /* Performance: Desactivar video en mobile */
  @media (max-width: 767px) {
    .video-element {
      display: none;
    }
  }
</style>
