---
/**
 * StatsSection Component
 * 
 * A responsive statistics showcase component featuring a hero image
 * alongside key business metrics. Implements a two-column layout that
 * adapts to single column on mobile devices.
 */

 import Certificate from "@/icons/Certificate.astro";
 import Container from "@/icons/Container.astro";
 import FileCheck from "@/icons/FileCheck.astro";
 import Clock from "@/icons/Clock.astro";

import { Image } from "astro:assets";
import services1 from "@/images/services1.webp";
import services2 from "@/images/services2.webp";
import services3 from "@/images/services3.webp";
import services4 from "@/images/services4.webp";

interface ServiceItem {
  label: string;
  description: string;
  icon: any;
  img: ImageMetadata;
}

const serviceFirst: ServiceItem[] = [
  {
    label: "Gestión Aduanera Especializada",
    description: "clasificación arancelaria precisa para optimizar el pago de tributos (GA, IVA) y evitar contravenciones. Gestión total de documentos (Bill of Lading, CRT, MIC/DTA).",
    icon: Container,
    img: services1
  },
  {
    label: "Transporte Multimodal (FCL / LCL)",
    description: "Soluciones de contenedor completo o carga consolidada desde los principales puertos del mundo hasta Arica o Iquique, con tramo final terrestre hasta Bolivia.",
    icon: FileCheck,
    img: services2
  },
  {
    label: "Verificación de Proveedores (Sourcing)",
    description: "Inspecciones de pre-embarque en origen y validación legal de fábricas en China para evitar estafas y asegurar la calidad de tu pedido.",
    icon: Clock,
    img: services3
  },
  {
    label: "Permisos y Certificaciones",
    description: "Gestión ante SENASAG, IBMETRO o Sustancias Controladas, garantizando el cumplimiento de la normativa técnica antes de que la carga llegue a frontera.",
    icon: Certificate,
    img: services4
  },
];
---

<section class="w-full py-30 relative px-4" id="services">
  <div class="max-w-6xl mx-auto relative z-5 flex flex-col gap-10">
    <!-- indicator -->
     <span class="text-gray-300 tracking-widest text-center title-section">Servicios</span>
    <!-- title section -->
     <h2 data-aos="zoom-in" class="card-item text-gray-100 font-title text-xl font-bold text-center md:text-2xl lg:text-4xl title-section">Servicios Especializados</h2>

    <!-- description -->
     <p data-aos="zoom-in" class="text-gray-200 text-center font-body text-base md:px-20 title-section">No solo movemos carga, gestionamos tu inversión. Especialistas en desaduanamiento, logística internacional y normativa vigente para asegurar que tu mercadería llegue a destino sin multas ni demoras.</p>

      <!-- Statistics grid -->
      <div class="space-y-8 grid gap-5
      md:grid-cols-2 md:gap-6 md:space-y-0
      lg:grid-cols-4 services-grid">
        {serviceFirst.map((stat) => (
          <div data-aos="fade-up" class="w-full h-full ">
            <div 
              class="pt-5 w-full h-full flex flex-col gap-6 shadow-xl bg-white rounded-xl hover:shadow-md items-center justify-between hover:border-accent hover:scale-105 transition duration-300
              md:gap-10 service-card"
            >
              <!-- Stat icon -->
              <div class="shrink-0 w-auto text-[#1849B2]">
                <stat.icon className="w-15 h-15" />
              </div>
              <!-- Stat content -->
              <div class="flex-1 font-body flex flex-col justify-between space-y-2 px-5">
                <h4 class="text-base font-bold text-stone-900 uppercase tracking-wide">
                  {stat.label}
                </h4>
                <p class="text-sm text-stone-600 leading-relaxed
                md:text-base">
                  {stat.description}
                </p>
              </div>

                <!-- Stat image -->
              <div class="relative w-full h-80 rounded-lg overflow-hidden">
                <Image
                  src={stat.img}
                  alt={stat.label}
                  class="absolute inset-0 w-full h-full object-cover object-center"
                />
              </div>
            </div>
          </div>
        ))}
    </div>
  </div>
</section>